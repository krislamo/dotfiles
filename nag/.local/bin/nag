#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Kris Lamoureux
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Runs each executable in the checks dir. Any output, non-zero exit, or
# timeout is sent, repeated every NAG_CHECKS_INTERVAL while unchanged, and
# followed by [resolved] once the check goes quiet.
#
#   NAG_CHECKS_SENDER    gotify (default), zulip, mail, or CMD TITLE MESSAGE
#   NAG_CHECKS_MAILTO    recipient for mail (root)
#   NAG_CHECKS_INTERVAL  seconds between repeats (21600)
#   NAG_CHECKS_TIMEOUT   seconds per check and per send (60)
#
#              user                         root
#   checks     ~/.config/nag-checks/        /opt/nag-checks/
#   cache      ~/.local/state/nag-checks/   /var/lib/nag-checks/
#
# Install, from the stow dir:
#   stow nag
#   loginctl enable-linger
#   systemctl --user daemon-reload
#   systemctl --user enable --now nag.timer
# With xstow, instead of stow nag:
#   mkdir -p ~/.local/bin ~/.config/systemd/user
#   xstow -t ~ nag
#
# Settings, add Environment=
#   systemctl --user edit nag.service
# Schedule, add OnCalendar= then e.g. OnCalendar=*:0/5
#   systemctl --user edit nag.timer
# Merged config
#   systemctl --user cat nag.service nag.timer
# Disable, which also deletes the stowed timer link
#   systemctl --user disable --now nag.timer
# As root, keep the stow dir in /root.

if ((EUID == 0)); then
	default_dir=/opt/nag-checks
	default_cache=/var/lib/nag-checks
else
	default_dir=${XDG_CONFIG_HOME:-$HOME/.config}/nag-checks
	default_cache=${XDG_STATE_HOME:-$HOME/.local/state}/nag-checks
fi

NAG_CHECKS_DIR=${NAG_CHECKS_DIR:-$default_dir}
NAG_CHECKS_CACHE=${NAG_CHECKS_CACHE:-$default_cache}
NAG_CHECKS_INTERVAL=${NAG_CHECKS_INTERVAL:-$((6 * 60 * 60))}
NAG_CHECKS_TIMEOUT=${NAG_CHECKS_TIMEOUT:-60}
NAG_CHECKS_SENDER=${NAG_CHECKS_SENDER:-gotify}
NAG_CHECKS_MAILTO=${NAG_CHECKS_MAILTO:-root}

prog=${0##*/}

info() {
	printf '[%s]: %s\n' "$prog" "$*"
}

err() {
	info "$@" >&2
}

die() {
	err "$@"
	exit 1
}

send() {
	local title=$1 msg=$2
	case $NAG_CHECKS_SENDER in
	gotify)
		timeout "$NAG_CHECKS_TIMEOUT" gotify 1 "$title" "$msg"
		;;
	zulip)
		timeout "$NAG_CHECKS_TIMEOUT" \
			zulipme "$title"$'\n```\n'"$msg"$'\n```'
		;;
	mail)
		timeout "$NAG_CHECKS_TIMEOUT" \
			mail -s "[$HOSTNAME] $title" "$NAG_CHECKS_MAILTO" <<<"$msg"
		;;
	*)
		timeout "$NAG_CHECKS_TIMEOUT" "$NAG_CHECKS_SENDER" "$title" "$msg"
		;;
	esac
}

case $NAG_CHECKS_SENDER in
gotify) sender=gotify ;;
zulip) sender=zulipme ;;
mail) sender=mail ;;
*) sender=$NAG_CHECKS_SENDER ;;
esac

for bin in "$sender" mkdir rm timeout; do
	if ! command -v "$bin" &>/dev/null; then
		die "missing $bin"
	fi
done

if [[ ! -d $NAG_CHECKS_DIR ]]; then
	die "missing $NAG_CHECKS_DIR"
fi

if [[ ! $NAG_CHECKS_INTERVAL =~ ^[0-9]+$ ]]; then
	die "NAG_CHECKS_INTERVAL must be seconds: '$NAG_CHECKS_INTERVAL'"
fi

if [[ ! $NAG_CHECKS_TIMEOUT =~ ^[0-9]+$ ]]; then
	die "NAG_CHECKS_TIMEOUT must be seconds: '$NAG_CHECKS_TIMEOUT'"
fi

if ! mkdir -p -m 700 "$NAG_CHECKS_CACHE"; then
	die "cannot create $NAG_CHECKS_CACHE"
fi

failed=0
printf -v now '%(%s)T' -1
shopt -s nullglob
for check in "$NAG_CHECKS_DIR"/*; do
	name=${check##*/}
	case $name in
	*.* | *~) continue ;;
	esac
	if [[ ! -f $check || ! -x $check ]]; then
		err "skipping '$name': not an executable file"
		failed=1
		continue
	fi

	if [[ ! -O $check ]]; then
		err "skipping '$name': not owned by uid $EUID"
		failed=1
		continue
	fi

	out=$(timeout -k 10 "$NAG_CHECKS_TIMEOUT" "$check" 2>&1)
	rc=$?
	if ((rc == 124 || rc > 128)); then
		out="[timed out or killed: exit $rc]${out:+$'\n'}$out"
	elif ((rc != 0)); then
		out="[exit $rc]${out:+$'\n'}$out"
	fi

	if [[ -z $out ]]; then
		if [[ -f $NAG_CHECKS_CACHE/$name ]]; then
			if send "$prog: $name" '[resolved]'; then
				info "resolved $name"
				if ! rm -f "$NAG_CHECKS_CACHE/$name"; then
					failed=1
				fi
			else
				err "push failed for $name"
				failed=1
			fi
		fi
		continue
	fi

	last=0
	old=''
	if [[ -f $NAG_CHECKS_CACHE/$name ]]; then
		old=$(<"$NAG_CHECKS_CACHE/$name")
		last=${old%%$'\n'*}
		old=${old#*$'\n'}
	fi

	if ((now - last < NAG_CHECKS_INTERVAL)) && [[ $out == "$old" ]]; then
		continue
	fi

	msg=$out
	if ((${#msg} > 4096)); then
		msg=${msg:0:4096}
		msg+=$'\n'"[truncated: $NAG_CHECKS_CACHE/$name]"
		err "truncated $name from ${#out} chars"
	fi

	if send "$prog: $name" "$msg"; then
		info "sent $name"
		if ! printf '%s\n%s\n' "$now" "$out" \
			>"$NAG_CHECKS_CACHE/$name"; then
			err "cannot write cache for $name"
			failed=1
		fi
	else
		err "push failed for $name"
		failed=1
	fi
done
exit "$failed"
